rules_version = '2';

// Cada pessoa lê e grava só o próprio documento users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'savedAt'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && request.resource.data.savedAt is number;
    }
  }
}
