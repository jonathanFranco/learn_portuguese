# Copie para .env.local e preencha com a config do app Web no console do Firebase
# (Configurações do projeto → Seus apps → SDK setup and configuration).
# Sem estas variáveis o app funciona só com localStorage, sem login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=